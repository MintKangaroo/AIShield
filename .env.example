# Copy to .env for local Docker development. Never commit .env.
AISHIELD_ENVIRONMENT=development
AISHIELD_LOG_LEVEL=INFO
AISHIELD_COMPUTE_DEVICE=cpu
AISHIELD_DATABASE_URL=postgresql://aishield:aishield@postgres:5432/aishield
AISHIELD_REDIS_URL=redis://redis:6379/0
AISHIELD_ARTIFACT_ROOT=/app/artifacts
AISHIELD_MODEL_ROOT=/app/artifacts/models
AISHIELD_DATASET_ROOT=/app/data
AISHIELD_ALLOW_PUBLIC_DOWNLOADS=false
AISHIELD_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
AISHIELD_API_PORT=8000
AISHIELD_DASHBOARD_PORT=3000

POSTGRES_DB=aishield
POSTGRES_USER=aishield
POSTGRES_PASSWORD=aishield
