# Copy to .env for local Docker development. Never commit .env.
AISHIELD_ENVIRONMENT=development
AISHIELD_LOG_LEVEL=INFO
AISHIELD_COMPUTE_DEVICE=cpu
AISHIELD_DATABASE_URL=postgresql://aishield:aishield@postgres:5432/aishield
AISHIELD_REDIS_URL=redis://redis:6379/0
AISHIELD_ARTIFACT_ROOT=/app/artifacts
AISHIELD_MODEL_ROOT=/app/artifacts/models
AISHIELD_DATASET_ROOT=/app/data
AISHIELD_ALLOW_PUBLIC_DOWNLOADS=false

# Leave unset to keep the registry open, which is what the local demo expects.
# Setting it (16+ characters) requires a key on every registry route; health
# probes, service discovery and the OpenAPI schema stay open.
# AISHIELD_API_KEY=

# Hosts you are authorized to run black-box attacks against. Empty (the default)
# refuses every remote attack; name only targets you own or have permission to test.
# AISHIELD_ATTACK_TARGETS_ALLOWLIST=["model.internal.example.com"]
# AISHIELD_REMOTE_ATTACK_MAX_QUERIES=20000

# Metadata store and job execution. "journal"/"inprocess" keep the stack to one
# process; "postgresql"/"redis" share state so a separate worker can run the
# heavy evaluations.
AISHIELD_METADATA_BACKEND=journal
AISHIELD_JOB_BACKEND=inprocess

# One heavy evaluation at a time; over-limit requests get 429 + Retry-After.
AISHIELD_MAX_CONCURRENT_RUNS=1

# Rebuild the in-memory index from stored metadata when the process starts.
AISHIELD_REPLAY_JOURNAL_ON_START=true

# Recorded in every evidence envelope; set it to the image digest deployed.
# AISHIELD_CONTAINER_IMAGE_DIGEST=
AISHIELD_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
AISHIELD_API_PORT=8000
AISHIELD_DASHBOARD_PORT=3000

POSTGRES_DB=aishield
POSTGRES_USER=aishield
POSTGRES_PASSWORD=aishield
